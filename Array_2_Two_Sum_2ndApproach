/*
Question: Given an array arr[] of n integers and a target value, check if there exists a pair whose sum equals the target. This is a variation of the 2Sum problem.

Examples: 

Input: arr[] = [0, -1, 2, -3, 1], target = -2
Output: true
Explanation: There is a pair (1, -3) with the sum equal to given target, 1 + (-3) = -2.

Input: arr[] = [1, -2, 1, 0, 5], target = 0
Output: false
Explanation: There is no pair with sum equals to given target. 
*/

#include<bits/stdc++.h>
using namespace std;

//Start : 2nd approach 
// Sorting and Binary Search - O(n*log(n)) time and O(1) space
bool binarysearch(vector<int>v, int start, int end, int value, int target) 
{     
    if(start > end)
     return false;
    int mid = (start + end)/2;     
    if(value + v[mid] == target)     
    return true;     
    else if((value + v[mid] < target))     
    {         
        start = mid+1;         
        return binarysearch(v, start, end, value, target);     
    }     
    else     
    {         
        end = mid-1;         
        return binarysearch(v, start, end, value, target);     
    } 
}  

bool Two_Sum(vector<int>v, int size, int target) 
{     
    sort(v.begin(), v.end());     
    for(int i = 0; i<size-1; i++)     
    {         
        int start = i+1;         
        int value = v[i];         
        int end = size-1;         
        bool result = binarysearch(v, start, end, value, target);        
        if(result)         
        return true;         
        else        
        continue;     
    }     
    return false; 
}  
//End : 2nd approach

