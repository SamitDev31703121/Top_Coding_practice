// Print Right View of a Binary Tree

/*
Given a Binary Tree, the task is to print the Right view of it. The right view of a Binary Tree is a set of rightmost nodes for every level.

Examples:   

Example 1: The nodes (1, 3, 5) represents the Right view in the below Binary tree.
       1 
     2    3 
        4   5

Example 2: The nodes (1, 3, 4, 5) represents the Right view in the below Binary tree.
       1 
     2    3 
   4   
      5
*/

//2nd approach - Using Queue and Level order traversal(BFS), TC - O(n), SC - O(n)  
#include <bits/stdc++.h>
using namespace std;

class node
{
    public:
    int data;
    node *left;
    node *right;
    
    node(int x)
    {
        data = x;
        left = right = nullptr;
    }
};

 void printrightview(node *root)
 {
    vector<int>result;
    if(root == nullptr)
     return;
     
    queue<node*> q;
    q.push(root);
    
    while(!q.empty())
    {
        int level = q.size();
        for(int i = 0; i<level; i++)
        {
            node *curr = q.front();
            q.pop();
            
            if(i == level-1)
            {
                result.push_back(curr->data);
            }
          if(curr ->left)
            q.push(curr ->left);
          if(curr->right)
            q.push(curr->right);
        }
    }
    
    for(auto i : result)
    {
        cout<<i<<" ";
    }
 }

int main()
{
    node *root = new node(1);
    root ->left = new node(2);
    root ->right = new node(3);
    root ->right ->left = new node(4);
    root ->right ->right = new node(5);
    printrightview(root);
    return 0;
}
