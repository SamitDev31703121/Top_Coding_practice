// Stock Buy and Sell - Max one Transaction Allowed

/*
Given an array prices[] of length N, representing the prices of the stocks on different days, the task is to find the maximum profit possible by buying and selling the stocks on different days when at most one transaction is allowed. Here one transaction means 1 buy + 1 Sell.

Note: Stock must be bought before being sold.

Examples:

Input: prices[] = {7, 10, 1, 3, 6, 9, 2}
Output: 8
Explanation: Buy for price 1 and sell for price 9. 

Input: prices[] = {7, 6, 4, 3, 1} 
Output: 0
Explanation: Since the array is sorted in decreasing order, 0 profit can be made without making any transaction.

Input: prices[] = {1, 3, 6, 9, 11} 
Output: 10
Explanation: Since the array is sorted in increasing order, we can make maximum profit by buying at price[0] and selling at price[n-1]
*/

#include<bits/stdc++.h>
using namespace std;

//Start : 2nd approach 
// Sorting and Two Pointers - O(nlogn) time and O(n) space

int maximum_Profit(vector<int>v, int size) 
{     
    int max_profit = 0;
    int j = size - 1;
    int i = 0;
   vector<int>v2 = v;
   sort(v2.begin(), v2.end());
   while(i < size -1)
   {
     if(j == i+1)  
     {
         i++;
         j = size - 1;
     }
     auto it2 = find(v.begin(), v.end(), v2[j]);
     int index_2 = it2 - v.begin();
     auto it1 = find(v.begin(), v.end(), v2[i]);
     int index_1 = it1 - v.begin();
   
     if(index_2 > index_1)
     {
        return v2[j] - v2[i] > 0 ? v2[j] - v2[i] : 0;
     }
     else
     {
       j--;
     }
   }
   return max_profit;
}  
//End : 2nd approach

int main() 
{
 int size;
    cin>>size;
    vector<int>v(size);
    cout<<"Size of Vector : "<<size<<endl;
        
    for(int i = 0; i<size; i++)
    {
        cin>>v[i];
    }
    cout<<"Vector elements : ";
    for(int i = 0; i<size; i++)
    {
        cout<<v[i]<<" ";
    }
    cout<<endl;
    
    int max_profit = maximum_Profit(v, size);
    cout<<"max_profit = "<<max_profit;
    return 0;
}
