// Print Right View of a Binary Tree

/*
Given a Binary Tree, the task is to print the Right view of it. The right view of a Binary Tree is a set of rightmost nodes for every level.

Examples:   

Example 1: The nodes (1, 3, 5) represents the Right view in the below Binary tree.
       1 
     2    3 
        4   5

Example 2: The nodes (1, 3, 4, 5) represents the Right view in the below Binary tree.
       1 
     2    3 
   4   
      5
*/

//1st approach - Using Recursion and queue, TC - O(n), SC - O(n)  
#include <bits/stdc++.h>
using namespace std;

class node
{
    public:
    int data;
    node *left;
    node *right;
    
    node(int x)
    {
        data = x;
        left = right = nullptr;
    }
};

 void printrightview(node *root, int level, int &maxlevel, queue<int>&q)
 {

    if(root == nullptr)
     return;
     
     if(level > maxlevel)
     {
         q.push(root -> data);
         maxlevel = level;
     }
        
        printrightview(root ->right, level+1, maxlevel, q);
        printrightview(root ->left, level+1, maxlevel, q);
 }

int main()
{
    node *root = new node(1);
    root ->left = new node(2);
    root ->right = new node(3);
    root ->right ->left = new node(4);
    root ->right ->right = new node(5);
    int level = 0;
    int maxlevel = -1;
    queue<int>q;
    printrightview(root, level, maxlevel, q);
    while (!q.empty()) 
    {
        cout << q.front() << " ";
        q.pop();
    }
    return 0;
}
